MARKETAUX_API_KEY=your_token_here
FINNHUB_API_KEY=your_token_here

# Used by scripts/alert_utils.py to email when TFDV validation finds anomalies or an
# Airflow task fails. Separate from the GitHub secrets used by the CI failure email.
# Gmail address + app password (https://myaccount.google.com/apppasswords); ALERT_RECIPIENTS is comma-separated
# e.g. GMAIL_USERNAME=finmlops.alerts@gmail.com
#      GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
#      ALERT_RECIPIENTS=you@northeastern.edu,teammate@northeastern.edu
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
ALERT_RECIPIENTS=

# Automated DVC snapshots: after process_news rebuilds news.parquet, publish_snapshot pushes
# the data to GCS and commits + pushes the pointer files to main. Off by default.
# Setup in docs/PIPELINE.md#automated-snapshots. The key file lives in secrets/ (git-ignored);
# the path below is where the containers see it.
AUTO_SNAPSHOT=false
# GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/project/secrets/dvc-service-account.json
# fine-grained token, this repo only, "Contents: Read and write"
GITHUB_TOKEN=
GIT_AUTHOR_NAME=finmlops-bot
GIT_AUTHOR_EMAIL=finmlops-bot@users.noreply.github.com
GIT_COMMITTER_NAME=finmlops-bot
GIT_COMMITTER_EMAIL=finmlops-bot@users.noreply.github.com
